{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "thoughts",
  "version": "0.13.1",
  "identifier": "cn.sxmind.thoughts",
  "build": {
    "beforeDevCommand": "npm run tauri:dev --prefix web",
    "devUrl": "http://localhost:8080",
    "beforeBuildCommand": "npm run tauri:build --prefix web",
    "frontendDist": "../dist-tauri"
  },
  "app": {
    "windows": [
      {
        "title": "思绪思维导图",
        "width": 1250,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["smm"],
        "name": "思绪思维导图",
        "description": "思绪思维导图文件",
        "role": "Editor"
      }
    ],
    "category": "Productivity",
    "shortDescription": "思绪思维导图",
    "publisher": "sxmind",
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true
      }
    }
  }
}
